<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_app">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="@drawable/bg_topbar">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Back"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/ss_mint_dark"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="14dp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Edit Lesson"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="@color/ss_ink"
            android:gravity="center"/>

        <View
            android:layout_width="52dp"
            android:layout_height="1dp"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="22dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="22dp">

            <!-- Lesson Order field -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lesson Order"
                android:textSize="13sp"
                android:textColor="@color/ss_text_soft"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/etOrder"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:inputType="number"
                android:textSize="16sp"
                android:textColor="#333333"
                android:paddingStart="12dp"
                android:background="@drawable/bg_card_mint"
                android:layout_marginBottom="20dp"/>

            <!-- Title field -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lesson Title"
                android:textSize="13sp"
                android:textColor="@color/ss_text_soft"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/etTitle"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:inputType="text"
                android:textSize="16sp"
                android:textColor="#333333"
                android:paddingStart="12dp"
                android:background="@drawable/bg_card_mint"
                android:layout_marginBottom="20dp"/>

            <!-- Body field -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lesson Content"
                android:textSize="13sp"
                android:textColor="@color/ss_text_soft"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/etBody"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:inputType="textMultiLine"
                android:gravity="top|start"
                android:textSize="15sp"
                android:textColor="#333333"
                android:paddingStart="12dp"
                android:paddingTop="12dp"
                android:background="@drawable/bg_card_mint"
                android:layout_marginBottom="8dp"/>

        </LinearLayout>
    </ScrollView>

    <!-- Save button -->
    <Button
        android:id="@+id/btnSave"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_margin="18dp"
        android:text="Save Changes"
        android:textAllCaps="false"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:background="@drawable/bg_button_primary"/>

</LinearLayout>